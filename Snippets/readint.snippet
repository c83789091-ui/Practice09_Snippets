<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Read Integer</Title>
      <Author>Student</Author>
      <Description>Reads an integer from console with validation.</Description>
      <Shortcut>readint</Shortcut>
    </Header>
    <Snippet>
      <Code Language="CSharp">
        <![CDATA[Console.Write("$Message$");
while (!int.TryParse(Console.ReadLine(), out int $Variable$))
{
    Console.Write("Ошибка ввода. $Message$");
}]]>
      </Code>
      <Declarations>
        <Literal>
          <ID>Message</ID>
          <ToolTip>Enter input prompt.</ToolTip>
          <Default>Введите число: </Default>
        </Literal>
        <Literal>
          <ID>Variable</ID>
          <ToolTip>Enter variable name.</ToolTip>
          <Default>number</Default>
        </Literal>
      </Declarations>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
